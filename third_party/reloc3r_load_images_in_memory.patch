         images[i]['true_shape'] = torch.Tensor(images[i]['true_shape']).to(device)
     return images
 
+
+def load_images_reloc3r(img_list, size, square_ok=False, verbose=False):
+    """Like ``load_images`` but accepts in-memory images (numpy arrays or
+    PIL images) instead of file paths, so callers can feed frames straight
+    from a video/ROS stream. Added for the GuideNav pipeline.
+
+    Args:
+        img_list: list of images. Each item may be an ``H x W x 3`` numpy
+            array (BGR, as returned by ``cv2.imread``) or a ``PIL.Image``.
+        size: target resolution (224 or 512), matching ``load_images``.
+    Returns:
+        list of dicts with keys ``img``, ``true_shape``, ``idx``, ``instance``
+        -- identical format to ``load_images``.
+    """
+    imgs = []
+    for item in img_list:
+        # Convert to a RGB PIL image.
+        if isinstance(item, np.ndarray):
+            arr = item
+            if arr.ndim == 2:  # grayscale
+                arr = cv2.cvtColor(arr, cv2.COLOR_GRAY2RGB)
+            else:  # assume BGR from cv2
+                arr = cv2.cvtColor(arr, cv2.COLOR_BGR2RGB)
+            img = PIL.Image.fromarray(arr).convert('RGB')
+        elif isinstance(item, PIL.Image.Image):
+            img = item.convert('RGB')
+        else:
+            raise ValueError(f'load_images_reloc3r: unsupported image type {type(item)}')
+
+        W1, H1 = img.size
+        if size == 224:
+            img = _resize_pil_image(img, round(size * max(W1 / H1, H1 / W1)))
+        else:
+            img = _resize_pil_image(img, size)
+        W, H = img.size
+        cx, cy = W // 2, H // 2
+        if size == 224:
+            half = min(cx, cy)
+            img = img.crop((cx - half, cy - half, cx + half, cy + half))
+        else:
+            halfw, halfh = ((2 * cx) // 16) * 8, ((2 * cy) // 16) * 8
+            if not square_ok and W == H:
+                halfh = 3 * halfw / 4
+            img = img.crop((cx - halfw, cy - halfh, cx + halfw, cy + halfh))
+
+        if verbose:
+            print(f' - adding image with resolution {W1}x{H1} --> {img.size[0]}x{img.size[1]}')
+        imgs.append(dict(img=ImgNorm(img)[None], true_shape=np.int32(
+            [img.size[::-1]]), idx=len(imgs), instance=str(len(imgs))))
+
+    assert imgs, 'load_images_reloc3r: no images provided'
+    return imgs
+
